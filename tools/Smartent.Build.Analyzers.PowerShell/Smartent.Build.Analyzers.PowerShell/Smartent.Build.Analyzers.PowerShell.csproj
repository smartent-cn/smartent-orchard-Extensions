<Project Sdk="Microsoft.NET.Sdk">

  <!-- This csproj file is only needed for NuGet package creation and to make the files visible in IDE. It doesn't
       contain anything that needs to be built. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*</DefaultItemExcludes>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Smartent PowerShell Analyzers</Title>
    <Authors>Smartent</Authors>
    <Copyright>Copyright © 2022, Smartent</Copyright>
    <Description>Smartent PowerShell Analyzers: PowerShell static code analysis via PSScriptAnalyzer (https://github.com/PowerShell/PSScriptAnalyzer) and Lombiq's recommended configuration for it. Use it from the CLI, in GitHub Actions, or integrated into MSBuild builds. See the project website for detailed documentation.</Description>
    <PackageIcon>NuGetIcon.png</PackageIcon>
    <PackageTags>Lombiq;Powershell;MSBuild</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-orchard-Extensions</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Readme.md" />
    <None Include="NuGetIcon.png" Pack="true" PackagePath="" />
    <None Include="Smartent.Build.Analyzers.PowerShell.targets" Pack="true" PackagePath="build\Smartent.Build.Analyzers.PowerShell.targets" />
    <None Include="Smartent.Build.Analyzers.PowerShell.NuGet.props" Pack="true" PackagePath="build\Smartent.Build.Analyzers.PowerShell.props" />
    <None Include="Invoke-Analyzer.ps1" Pack="true" PackagePath="" />
    <None Include="PSScriptAnalyzerSettings.psd1" Pack="true" PackagePath="" />
    <None Include="Rules\**" Pack="true" PackagePath="Rules\" />
  </ItemGroup>

</Project>
