<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Setup</RootNamespace>
    <AssemblyName>Smartent.Orchard.Setup</AssemblyName>
    <PackageId>Smartent.Orchard.Setup</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.Base.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Lombiq.MSBuild.Base.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Setup Extensions</Title>
    <CopyrightYear>2020</CopyrightYear>
    <DescriptionBody>Orchard Core 应用安装与启动配置扩展（原 Lombiq.SetupExtensions）。</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Setup</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules/tree/master/Smartent-src/Build/Smartent.Orchard.Setup</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Overrides Orchard Core's vulnerable transitive version. -->
    <PackageReference Include="AngleSharp" Version="1.9.1" />
    <PackageReference Include="OrchardCore.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Infrastructure" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="MySqlConnector" Version="2.6.2" NoWarn="NU1510" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" NoWarn="NU1510" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.Base.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Lombiq.MSBuild.Base.Sdk" Version="2.1.1" />
</Project>
