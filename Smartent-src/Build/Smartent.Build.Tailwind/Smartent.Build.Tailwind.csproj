<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*;node_modules/**</DefaultItemExcludes>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Smartent.Build.Tailwind</RootNamespace>
    <AssemblyName>Smartent.Build.Tailwind</AssemblyName>
    <PackageId>Smartent.Build.Tailwind</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../Smartent.Build.Base.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.Base.Sdk" Version="2.1.1-alpha.9.osoe-344" />

  <PropertyGroup>
    <Title>Smartent Tailwind MSBuild Targets</Title>
    <CopyrightYear>2026</CopyrightYear>
    <DescriptionBody>在 .NET 构建中运行 Tailwind CSS，无需在消费项目中安装 Node.js。</DescriptionBody>
    <PackageTags>Smartent;Tailwind;MSBuild;OrchardCore</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules/tree/master/Smartent-src/Build/Smartent.Build.Tailwind</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="*.props" Pack="true" PackagePath="" />
    <None Include="*.targets" Pack="true" PackagePath="" />
    <None Remove="node_modules/**" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../Smartent.Build.Base.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.Base.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>
