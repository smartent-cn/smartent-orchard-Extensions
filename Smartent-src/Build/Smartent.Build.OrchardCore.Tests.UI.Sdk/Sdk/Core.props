<Project>
  <PropertyGroup>
    <SmartentSdkName>OrchardCore.Tests.UI</SmartentSdkName>
    <LombiqSdkName>$(SmartentSdkName)</LombiqSdkName>
  </PropertyGroup>
  
  <ItemGroup Condition="'$(FromNuGet)' != 'true'">
    <ProjectReference Include="$(SmartentSolutionRootPath)/Smartent-src/Test/Smartent.Test.UI/Smartent.Test.UI/Smartent.Test.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' == 'true'">
    <PackageReference Include="Smartent.Test.UI">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionLombiqTestsUI)</Version>
    </PackageReference>
  </ItemGroup>
</Project>
