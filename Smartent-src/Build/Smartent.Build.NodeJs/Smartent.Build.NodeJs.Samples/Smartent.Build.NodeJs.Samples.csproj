<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Smartent.Build.NodeJs\Smartent.Build.NodeJs.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- This is necessary to support netstandard2.0. -->
    <LangVersion>8.0</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*;node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Build.NodeJs\Smartent.Build.NodeJs.csproj" />
  </ItemGroup>

  <Target Name="AssertNodeJsExtensionsConfiguration" BeforeTargets="_BeforeResolveReferences">
    <Message Text="Assert correct parsing of Node.js Extensions configuration from package.json." Importance="$(NxVerbosity)" />
    <Error Condition="'$(_NxConfiguration)' == ''" Code="NE00" Text="Extraction of Node.js Extensions configuration is broken." />
  </Target>

  <Import Project="..\Smartent.Build.NodeJs\Smartent.Build.NodeJs.targets" />

</Project>
