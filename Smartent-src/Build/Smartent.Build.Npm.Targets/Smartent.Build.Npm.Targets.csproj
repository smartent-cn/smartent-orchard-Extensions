<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Smartent.Build.Npm.Targets</RootNamespace>
    <AssemblyName>Smartent.Build.Npm.Targets</AssemblyName>
    <PackageId>Smartent.Build.Npm.Targets</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../Smartent.Build.Base.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.Base.Sdk" Version="2.1.1-alpha.9.osoe-344" />

  <PropertyGroup>
    <Title>Smartent NPM MSBuild Targets</Title>
    <CopyrightYear>2020</CopyrightYear>
    <DescriptionBody>在构建前自动执行 npm/pnpm 安装与自定义脚本（原 Lombiq.Npm.Targets）。</DescriptionBody>
    <PackageTags>Smartent;NPM;Node.js;MSBuild;Build</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules/tree/master/Smartent-src/Build/Smartent.Build.Npm.Targets</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="*.props" Pack="true" PackagePath="" />
    <None Include="*.targets" Pack="true" PackagePath="" />
    <None Remove="node_modules/**" />
    <None Update="build\LoadCopyVendorsTask.targets">
      <Pack>true</Pack>
      <PackagePath>build/</PackagePath>
    </None>
    <None Update="build\LoadExecWithMutexTask.targets">
      <Pack>true</Pack>
      <PackagePath>build/</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../Smartent.Build.Base.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.Base.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>