<Project>
  <Import Project="$(LombiqMSBuildLibManTargetsPath)/Smartent.Build.LibMan.Targets.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.LibraryManager.Build">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">3.0.114</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' == 'true'">
    <PackageReference Include="Smartent.Core.CodeGen.Attributes" OutputItemType="Analyzer" ReferenceOutputAssembly="true">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionSmartentPlatform)</Version>
    </PackageReference>
    <PackageReference Include="Smartent.Core.CodeGen.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionSmartentPlatform)</Version>
    </PackageReference>
  </ItemGroup>
</Project>
