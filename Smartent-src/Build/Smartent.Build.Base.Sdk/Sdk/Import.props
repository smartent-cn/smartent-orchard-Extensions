<Project>
  <!-- You can't set the target framework inside a NuGet package because that information is used to find it in the
       first place, so setting TargetFramework only makes sense when this SDK is imported from submodule. -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Base paths used to normalize ProjectReference paths. Relative paths are used to make them shorter. -->
  <PropertyGroup>
    <LombiqSolutionRootPath Condition="'$(LombiqSolutionRootPath)' == ''"
      >$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(MSBuildThisFileDirectory)../../../..'))</LombiqSolutionRootPath>
    <SmartentSrcPath Condition="'$(SmartentSrcPath)' == '' AND '$(LombiqSolutionRootPath)' != ''"
      >$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(LombiqSolutionRootPath)/Smartent-src'))</SmartentSrcPath>
    <SmartentPlatformPath Condition="'$(SmartentPlatformPath)' == '' AND '$(SmartentSrcPath)' != ''"
      >$(SmartentSrcPath)/Platform/Orchard</SmartentPlatformPath>
    <LombiqAnalyzersPath Condition="'$(LombiqAnalyzersPath)' == '' AND '$(LombiqSolutionRootPath)' != ''"
      >$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(LombiqSolutionRootPath)/tools/Smartent.Build.Analyzers'))</LombiqAnalyzersPath>
    <SmartentAnalyzersPath Condition="'$(SmartentAnalyzersPath)' == '' AND '$(LombiqAnalyzersPath)' != ''"
      >$(LombiqAnalyzersPath)</SmartentAnalyzersPath>
    <LombiqMSBuildLibManTargetsPath>$(MSBuildThisFileDirectory)../../Smartent.Build.LibMan.Targets</LombiqMSBuildLibManTargetsPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Core.props" />
</Project>
