<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.EmailClient.Tests.UI</RootNamespace>
    <AssemblyName>Smartent.Orchard.EmailClient.Tests.UI</AssemblyName>
    <PackageId>Smartent.Orchard.EmailClient.Tests.UI</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Lombiq.MSBuild.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Lombiq Email Client for Orchard Core - UI Test Extensions</Title>
    <CopyrightYear>2025</CopyrightYear>
    <DescriptionBody>Extension methods that test various features in Lombiq Email Client for Orchard Core.</DescriptionBody>
    <PackageTags>OrchardCore;Lombiq;AspNetCore;Email;IMAP;Shouldly;xUnit;UITesting;Testing</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/Orchard-Email-Client</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Lombiq/Orchard-Email-Client/blob/dev/Smartent.Orchard.EmailClient.Tests.UI/Readme.md</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.EmailClient.Samples\Smartent.Orchard.EmailClient.Samples.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestEmails\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Lombiq.MSBuild.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />
</Project>
