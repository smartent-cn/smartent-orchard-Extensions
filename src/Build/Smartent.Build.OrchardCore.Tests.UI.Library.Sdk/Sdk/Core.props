<Project>
  <PropertyGroup>
    <SmartentSdkName>OrchardCore.Tests.UI.Library</SmartentSdkName>
  </PropertyGroup>

  <ItemGroup Condition="'$(FromNuGet)' != 'true'">
    <ProjectReference Include="$(SmartentSolutionRootPath)/src/Test/Smartent.Test.UI/Smartent.Test.UI/Smartent.Test.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' == 'true'">
    <PackageReference Include="Smartent.Test.UI">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionSmartentTestsUI)</Version>
    </PackageReference>
  </ItemGroup>
</Project>
