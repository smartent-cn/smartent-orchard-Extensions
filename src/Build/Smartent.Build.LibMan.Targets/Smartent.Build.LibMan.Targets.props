<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <FromNuGet Condition="'$(FromNuGet)' == ''">$(NuGetBuild)</FromNuGet>
    <SmartentMSBuildLibManTarget Condition="'$(SmartentMSBuildLibManTarget)' == ''">wwwroot\vendors</SmartentMSBuildLibManTarget>
  </PropertyGroup>

  <!-- Configuration -->

  <PropertyGroup>
    <_SmartentCoreCodeGenPath Condition="'$(_SmartentCoreCodeGenPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\Platform\Core'))</_SmartentCoreCodeGenPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FromNuGet)' != 'true'">
    <_SourceGeneratorLocation>$(_SmartentCoreCodeGenPath)\Smartent.Core.CodeGen.SourceGenerators\bin\$(Configuration)\netstandard2.0\Smartent.Core.CodeGen.SourceGenerators.dll</_SourceGeneratorLocation>
    <SourceGeneratorLocation Condition="'$(SourceGeneratorLocation)' == '' AND Exists(_SourceGeneratorLocation)">$(_SourceGeneratorLocation)</SourceGeneratorLocation>
  </PropertyGroup>

  <!-- Smartent CodeGen (monorepo) -->

  <ItemGroup Condition="'$(FromNuGet)' != 'true'">
    <ProjectReference Include="$(_SmartentCoreCodeGenPath)\Smartent.Core.CodeGen.Attributes\Smartent.Core.CodeGen.Attributes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="$(_SmartentCoreCodeGenPath)\Smartent.Core.CodeGen.SourceGenerators\Smartent.Core.CodeGen.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Additional files -->

  <ItemGroup>
    <AdditionalFiles Include="libman.json" />
  </ItemGroup>

</Project>
