<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-orchard-Extensions/tree/master/src/Build/Smartent.Build.Base.Sdk</PackageProjectUrl>
    <Title>Smartent MSBuild SDK - Base</Title>
    <Description>Base SDK for other Smartent MSBuild SDKs. Don't use this directly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../Docs/*.*">
      <Link>Docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
