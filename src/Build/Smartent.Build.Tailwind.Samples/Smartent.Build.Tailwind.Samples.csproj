<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1-alpha.9.osoe-344" />

  <Import Project="..\Smartent.Build.Tailwind\Smartent.Build.Tailwind.props" />

  <PropertyGroup>
  <!-- Use checked-in wwwroot/css/site.css when GitHub CLI download is unavailable. -->
    <TailwindRunOnBuild Condition="Exists('$(TailwindCliPath)')">true</TailwindRunOnBuild>
    <TailwindRunOnBuild Condition="!Exists('$(TailwindCliPath)')">false</TailwindRunOnBuild>
    <TailwindCliDownload Condition="!Exists('$(TailwindCliPath)')">false</TailwindCliDownload>
  </PropertyGroup>

  <Import Project="..\Smartent.Build.Tailwind\Smartent.Build.Tailwind.targets" />

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>
