<Project>
  <PropertyGroup>
    <SmartentSdkName>OrchardCore.Module</SmartentSdkName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(OrchardCoreVersion)</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Recipes\*.recipe.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' != 'true'">
    <ProjectReference Include="$(SmartentSolutionRootPath)/src/Platform/Orchard/Smartent.Orchard.Platform/Smartent.Orchard.Platform.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' == 'true'">
    <PackageReference Include="Smartent.Orchard.Platform">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionSmartentPlatform)</Version>
    </PackageReference>
  </ItemGroup>
</Project>
