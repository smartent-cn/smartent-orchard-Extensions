<Project>
  <PropertyGroup>
    <LombiqSdkName>OrchardCore.Tests.UI.Library</LombiqSdkName>
  </PropertyGroup>

  <ItemGroup Condition="'$(FromNuGet)' != 'true'">
    <ProjectReference Include="$(LombiqSolutionRootPath)/Smartent-src/Test/Smartent.Test.UI/Smartent.Test.UI/Smartent.Test.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FromNuGet)' == 'true'">
    <PackageReference Include="Smartent.Test.UI">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(PackageVersionLombiqTestsUI)</Version>
    </PackageReference>
  </ItemGroup>
</Project>
