<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  
  <Choose>
    <When Condition="$(MSBuildProjectName.EndsWith('.Tests')) OR $(MSBuildProjectName.EndsWith('.Tests.UI')) OR $(MSBuildProjectName.EndsWith('.Samples'))">
      <!-- Adda anything specific to non-publishable projects here. -->
    </When>

    <Otherwise>
      <PropertyGroup>
        <Authors Condition="'$(Authors)' == ''">Smartent</Authors>
        <Company Condition="'$(Company)' == ''">Smartent</Company>
        <Copyright Condition="'$(Copyright)' == ''">Copyright © Smartent</Copyright>
        <PackageIcon>NuGetIcon.png</PackageIcon>
        <PackageTags Condition="'$(PackageTags)' == ''">OrchardCore;Smartent;AspNetCore;MSBuild</PackageTags>
        <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
        <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://gitee.com/smartent/smartent-training-demo-modules/tree/master/src/Utilities/Lombiq.MSBuild.Targets</PackageProjectUrl>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
        <!-- NuGet PackageId 仍为 Lombiq.MSBuild.*，待全仓 Sdk= 切换后再改为 Smartent.Build.* -->
      </PropertyGroup>

      <ItemGroup>
        <None Include="Readme.md" Condition="Exists('Readme.md')" />
        <None Include="NuGetIcon.png" Pack="true" PackagePath="" Condition="Exists('NuGetIcon.png')" />
        <None Include="Sdk\**" Pack="true" PackagePath="Sdk\" Condition="Exists('Sdk')" />
        <None Include="build\**" Pack="true" PackagePath="build\" Condition="Exists('build')" />
      </ItemGroup>

      <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Sdk'))">
        <None Include="..\..\..\Smartent-src\Build\Lombiq.MSBuild.LibMan.Targets\*.*"
              Link="Lombiq.MSBuild.LibMan.Targets\*.*"
              Pack="true"
              PackagePath="Lombiq.MSBuild.LibMan.Targets\"
              Visible="false"/>
      </ItemGroup>

      <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Sdk')) AND MSBuildProjectName != 'Lombiq.MSBuild.Base.Sdk'">
        <None Include="..\..\..\Smartent-src\Build\Lombiq.MSBuild.Base.Sdk\Sdk\*.*"
              Link="Lombiq.MSBuild.Base.Sdk\*.*"
              Pack="true"
              PackagePath="Lombiq.MSBuild.Base.Sdk\"
              Visible="false"/>
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
