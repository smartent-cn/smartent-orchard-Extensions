<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>    <RootNamespace>Smartent.Orchard.UIKit.Widgets</RootNamespace>
    <AssemblyName>Smartent.Orchard.UIKit.Widgets</AssemblyName>
    <PackageId>Smartent.Orchard.UIKit.Widgets</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard UI Kit - Widgets for Orchard Core</Title>
    <CopyrightYear>2024</CopyrightYear>
    <DescriptionBody>This module contains widgets based on shapes from Smartent Orchard UI Kit.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;UI;UIKit;Widgets;front-end</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Flows" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Media" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
      <ProjectReference Include="..\Smartent.Orchard.UIKit\Smartent.Orchard.UIKit.csproj" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />
</Project>