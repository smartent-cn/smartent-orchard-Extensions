<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Hosting.Tenants.EmailQuotaManagement</RootNamespace>
    <AssemblyName>Smartent.Orchard.Hosting.Tenants.EmailQuotaManagement</AssemblyName>
