<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Hosting.Tenants.HealthChecks</RootNamespace>
    <AssemblyName>Smartent.Orchard.Hosting.Tenants.HealthChecks</AssemblyName>
    <PackageId>Smartent.Orchard.Hosting.Tenants.HealthChecks</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Tenants Health Checks for Orchard Core</Title>
    <CopyrightYear>2021</CopyrightYear>
    <DescriptionBody>Multi-tenancy related health check improvements.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Multitenancy;SaaS;HealthChecks</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Tenants" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.HealthChecks" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>
