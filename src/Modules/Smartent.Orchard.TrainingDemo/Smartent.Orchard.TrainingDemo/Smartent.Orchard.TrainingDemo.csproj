<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>Smartent.Orchard.TrainingDemo</RootNamespace>
    <AssemblyName>Smartent.Orchard.TrainingDemo</AssemblyName>
    <PackageId>Smartent.Orchard.TrainingDemo</PackageId>
    <Title>Smartent Orchard Training Demo</Title>
    <Description>Orchard Core 教学演示模块。</Description>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-orchard-Extensions/tree/master/src/Modules/Smartent.Orchard.TrainingDemo</PackageProjectUrl>
    <PackageTags>OrchardCore;Smartent;training</PackageTags>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*</DefaultItemExcludes>
    <OrchardCoreVersion>3.0.1</OrchardCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Readme.md" Link="Readme.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageReference Include="OrchardCore.Users.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Workflows.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.BackgroundTasks" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentFields" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Data.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.DynamicCache" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.FileStorage.FileSystem" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Indexing.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Media.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="$(OrchardCoreVersion)" />
    <!-- Note that you need to add a reference to OrchardCore.ResourceManagement for the basic tag helpers like <style>
    and <script> to properly work when the app is built for production (and thus Razor Runtime Compilation is turned
    off. OrchardCore.DisplayManagement is needed for a variety of things but also for the <shape> tag helper for the
    same reason. -->
    <PackageReference Include="OrchardCore.ResourceManagement" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <!-- This module requires Smartent.Orchard.Platform, and it can be included two ways. The PackageReference
  is used by the standalone solution, while ProjectReference is needed when including the module in
  https://github.com/smartent-cn/smartent-orchard-Extensions. Only one of the two is ever active. -->

  <ItemGroup Condition="Exists('..\..\..\Platform\Orchard\Smartent.Orchard.Platform\Smartent.Orchard.Platform.csproj')">
    <ProjectReference Include="..\..\..\Platform\Orchard\Smartent.Orchard.Platform\Smartent.Orchard.Platform.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\..\..\Platform\Orchard\Smartent.Orchard.Platform\Smartent.Orchard.Platform.csproj')">
    <PackageReference Include="Smartent.Orchard.Platform" Version="13.0.1-alpha.5.osoe-344" />
  </ItemGroup>

  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="MySqlConnector" Version="2.6.2" NoWarn="NU1510" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" NoWarn="NU1510" />
  </ItemGroup>

  <!-- Suppresses vulnerabilities in 'SixLabors.ImageSharp' version 3.1.12, until the Orchard Core upgrade to v4 is
  released that drops ImageSharp. -->
  <ItemGroup Condition="'$(SmartentSdkName)' == ''">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
  </ItemGroup>

</Project>
