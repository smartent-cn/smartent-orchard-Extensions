<!-- This should rather be a props file, but those are overwritten by Orchard's Package.Build.props for modules. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Setting a test value just when working in the Smartent solution. -->
  <PropertyGroup Condition="'$(BuildUrl)' == '' AND '$(SolutionName)' == 'Smartent.Orchard'">
    <BuildVersionDisplay_BuildUrl>
      https://github.com/smartent-cn/smartent-orchard-Extensions/actions/runs/123
    </BuildVersionDisplay_BuildUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Smartent.Orchard.Hosting.BuildVersion.BuildUrlAttribute">
      <_Parameter1>$(BuildVersionDisplay_BuildUrl)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>