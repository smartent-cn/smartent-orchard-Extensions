<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Hosting.BuildVersion</RootNamespace>
    <AssemblyName>Smartent.Orchard.Hosting.BuildVersion</AssemblyName>
    <PackageId>Smartent.Orchard.Hosting.BuildVersion</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Build Version Display for Orchard Core</Title>
    <CopyrightYear>2023</CopyrightYear>
    <DescriptionBody>Orchard Core module to display the build version (i.e. .NET assembly version or other) on the admin of the Default tenant.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Hosting;</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- If this is not explicitly specified then OrchardCore.Module.Targets will take over the build folder and it
    won't be included. -->
    <None Include="build\Smartent.Orchard.Hosting.BuildVersion.targets" Pack="true" PackagePath="build\Smartent.Orchard.Hosting.BuildVersion.targets" />
  </ItemGroup>

  <!-- The targets file will be automatically imported when using the project from NuGet but needs an explicit import
  when used from source. -->
  <Import Project="build/Smartent.Orchard.Hosting.BuildVersion.targets" Condition="'$(NuGetBuild)' != 'true'" />

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>
