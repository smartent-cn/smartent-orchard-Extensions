<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Privacy</RootNamespace>
    <AssemblyName>Smartent.Orchard.Privacy</AssemblyName>
    <PackageId>Smartent.Orchard.Privacy</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />
 
  <PropertyGroup>
    <Title>Smartent Orchard Privacy for Orchard Core</Title>
    <CopyrightYear>2018</CopyrightYear>
    <DescriptionBody>Orchard module containing features related to data protection/privacy and the EU law on it, the General Data Protection Regulation (GDPR).</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;GDPR;Privacy</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.CustomSettings" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Forms" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Liquid" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Users" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1-alpha.9.osoe-344" />
</Project>
