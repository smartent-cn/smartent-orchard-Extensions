<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="..\..\..\Build\Smartent.Build.NodeJs\Smartent.Build.NodeJs\Smartent.Build.NodeJs.props" />
  <Import Project="..\Smartent.Orchard.VueJs\Smartent.Orchard.VueJs.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.VueJs.Samples</RootNamespace>
    <AssemblyName>Smartent.Orchard.VueJs.Samples</AssemblyName>
    <PackageId>Smartent.Orchard.VueJs.Samples</PackageId>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*;node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <Title>Smartent Orchard Vue.js module for Orchard Core - Samples</Title>
    <Authors>Smartent</Authors>
    <Copyright>Copyright © 2019, Smartent</Copyright>
    <Description>Smartent Orchard Vue.js module for Orchard Core - Samples: Sample content that demonstrates the features of Smartent Orchard Vue.js module for Orchard Core.</Description>
    <PackageIcon>NuGetIcon.png</PackageIcon>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Vue.js</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" />
    <None Include="NuGetIcon.png" Pack="true" PackagePath="" />

    <None Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.ContentFields" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ResourceManagement" Version="$(OrchardCoreVersion)" />
    <!-- Only needed to override the vulnerable version referenced by ZXing.Net.Bindings.ImageSharp.V3. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="ZXing.Net.Bindings.ImageSharp.V3" Version="0.16.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.VueJs\Smartent.Orchard.VueJs.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' != 'true'">
    <ProjectReference Include="..\..\..\Platform\Core\Smartent.Core.Primitives\Smartent.Core.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' == 'true'">
    <PackageReference Include="Smartent.Build.NodeJs" Version="3.0.0" />
    <PackageReference Include="Smartent.Core.Primitives" Version="12.6.1-alpha.7.osoe-925" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="..\..\..\Build\Smartent.Build.NodeJs\Smartent.Build.NodeJs\Smartent.Build.NodeJs.targets" />
  <Import Project="..\Smartent.Orchard.VueJs\Smartent.Orchard.VueJs.targets" />

</Project>
