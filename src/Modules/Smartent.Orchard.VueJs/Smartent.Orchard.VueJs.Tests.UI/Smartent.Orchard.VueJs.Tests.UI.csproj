<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.VueJs.Tests.UI</RootNamespace>
    <AssemblyName>Smartent.Orchard.VueJs.Tests.UI</AssemblyName>
    <PackageId>Smartent.Orchard.VueJs.Tests.UI</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Smartent Orchard Vue.js module for Orchard Core - UI Test Extensions</Title>
    <Authors>Smartent</Authors>
    <Copyright>Copyright © 2019, Smartent</Copyright>
    <Description>Smartent Orchard Vue.js module for Orchard Core - UI Test Extensions: Extensions to aid in UI testing Smartent Orchard Vue.js module for Orchard Core.</Description>
    <PackageIcon>NuGetIcon.png</PackageIcon>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Vue.js</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-orchard-Extensions</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.VueJs.Samples\Smartent.Orchard.VueJs.Samples.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' != 'true'">
    <ProjectReference Include="..\..\..\Test\Smartent.Test.UI\Smartent.Test.UI\Smartent.Test.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' == 'true'">
    <PackageReference Include="Smartent.Test.UI" Version="14.2.2-alpha.10.osoe-925" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NuGetIcon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Media\john.doe.mjpeg" />
    <EmbeddedResource Include="Assets\Media\richard.roe.mjpeg" />
    <EmbeddedResource Include="Readme.md">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
