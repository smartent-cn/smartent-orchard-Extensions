<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Hosting.ApplicationInsights</RootNamespace>
    <AssemblyName>Smartent.Orchard.Hosting.ApplicationInsights</AssemblyName>
    <PackageId>Smartent.Orchard.Hosting.ApplicationInsights</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Azure Application Insights for Orchard Core</Title>
    <CopyrightYear>2015</CopyrightYear>
    <DescriptionBody>This Orchard Core module enables easy integration of Azure Application Insights telemetry into Orchard. Just install the module, configure the instrumentation key from a configuration source, and collected data will start appearing in the Azure Portal.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Azure;ApplicationInsights;Analytics;Telemetry;Monitoring;SmartentHosting</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.Profiler.AspNetCore" Version="3.0.2">
      <!-- This is needed to include the Uploader component (TraceUpload.zip) in the publish output folder, and thus
      deploy it to the server too. See:
      https://github.com/microsoft/ApplicationInsights-Profiler-AspNetCore/issues/241#issuecomment-3706178984. -->
      <PrivateAssets>analyzers;build</PrivateAssets>
    </PackageReference>
    <!-- Overriding the vulnerable transitive version coming from Microsoft.ApplicationInsights.AspNetCore. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" NoWarn="NU1510" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" NoWarn="NU1510" />
    <PackageReference Include="OrchardCore.Media.Azure" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />
</Project>
