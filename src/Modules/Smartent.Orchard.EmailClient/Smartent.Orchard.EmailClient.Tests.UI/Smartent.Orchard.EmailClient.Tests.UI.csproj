<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.EmailClient.Tests.UI</RootNamespace>
    <AssemblyName>Smartent.Orchard.EmailClient.Tests.UI</AssemblyName>
    <PackageId>Smartent.Orchard.EmailClient.Tests.UI</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Email Client for Orchard Core - UI Test Extensions</Title>
    <CopyrightYear>2025</CopyrightYear>
    <DescriptionBody>Extension methods that test various features in Smartent Orchard Email Client for Orchard Core.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Email;IMAP;Shouldly;xUnit;UITesting;Testing</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-orchard-Extensions</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.EmailClient.Samples\Smartent.Orchard.EmailClient.Samples.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestEmails\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />
</Project>
