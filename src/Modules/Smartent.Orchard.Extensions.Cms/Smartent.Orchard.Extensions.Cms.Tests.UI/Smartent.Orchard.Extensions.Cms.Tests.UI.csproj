<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>    <RootNamespace>Smartent.Orchard.Extensions.Cms.Tests.UI</RootNamespace>
    <AssemblyName>Smartent.Orchard.Extensions.Cms.Tests.UI</AssemblyName>
    <PackageId>Smartent.Orchard.Extensions.Cms.Tests.UI</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Extensions for Orchard Core - UI Test Extensions</Title>
    <Authors>Smartent</Authors>
    <CopyrightYear>2013</CopyrightYear>
    <DescriptionBody>Extension methods that test various features in Smartent Orchard Extensions for Orchard Core.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;CodeGeneration;ShapeTracing;Widgets</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Recipes\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" Version="$(OrchardCoreVersion)">
      <Aliases>OCCMA</Aliases>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.Extensions.Cms\Smartent.Orchard.Extensions.Cms.csproj" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Tests.UI.Library.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Tests.UI.Library.Sdk" Version="2.1.1" />
</Project>