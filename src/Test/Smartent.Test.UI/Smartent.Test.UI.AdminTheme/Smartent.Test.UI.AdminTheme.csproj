<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent UI Testing - Admin Theme</Title>
    <CopyrightYear>2020</CopyrightYear>
    <DescriptionBody>Adjustments for the stock Orchard Core admin theme to make it more automation-friendly.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Selenium;Atata;Shouldly;xUnit;Axe;AccessibilityTesting;UITesting;Testing;Automation</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-training-demo-modules</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/smartent/smartent-training-demo-modules</PackageProjectUrl>
  </PropertyGroup>

  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="MySqlConnector" Version="2.6.2" NoWarn="NU1510" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" NoWarn="NU1510" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1" />
</Project>
