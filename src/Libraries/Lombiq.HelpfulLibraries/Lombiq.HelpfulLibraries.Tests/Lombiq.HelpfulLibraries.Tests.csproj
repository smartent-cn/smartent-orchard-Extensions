  <PropertyGroup>
    <SourceGeneratorLocation>$(SolutionDir)Smartent-src\Platform\Core\Smartent.Core.CodeGen.SourceGenerators\bin\Debug\netstandard2.0\Smartent.Core.CodeGen.SourceGenerators.dll</SourceGeneratorLocation>
