{
  "name": "Smartent.Demo.Tests.FeaturesGuard",
  "displayName": "Smartent's Open-Source Orchard Core Extensions",
  "description": "Smartent's Open-Source Orchard Core Extensions setup recipe for automated UI test execution.",
  "author": "Smartent",
  "website": "https://github.com/smartent-cn/smartent-orchard-Extensions",
  "version": "1.0",
  "issetuprecipe": false,
  "categories": [
    "test"
  ],
  "tags": [
    "test"
  ],
  "steps": [
    {
      "name": "feature",
      "disable": [],
      "enable": [
        "OrchardCore.Tenants",
        "OrchardCore.Tenants.FeatureProfiles",
        "Smartent.Orchard.Hosting.Tenants.FeaturesGuard"
      ]
    },
    {
      "name": "FeatureProfiles",
      "FeatureProfiles": {
        "Features Guard": {
          "FeatureRules": [
            {
              "Rule": "Exclude",
              "Expression": "OrchardCore.Workflows.Session"
            },
            {
              "Rule": "Exclude",
              "Expression": "OrchardCore.Search.Lucene"
            },
            {
              "Rule": "Exclude",
              "Expression": "OrchardCore.MiniProfiler"
            },
            {
              "Rule": "Exclude",
              "Expression": "Smartent.Test.UI.Shortcuts"
            }
          ]
        }
      }
    }
  ]
}
