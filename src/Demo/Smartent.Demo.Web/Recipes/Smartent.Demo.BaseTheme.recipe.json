{
  // This is necessary to be in a separate recipe, because otherwise the widget and layer setup from
  // Smartent.BaseTheme.LayersAndZones.recipe would be superseded by the default config.
  "name": "Smartent.Demo.BaseTheme",
  "displayName": "Switch to Smartent.Orchard.Theme.Base.Samples",
  "description": "Switch to Smartent.Orchard.Theme.Base.Samples theme for tests.",
  "author": "Smartent",
  "website": "https://github.com/smartent-cn/smartent-orchard-Extensions",
  "version": "1.0",
  "issetuprecipe": false,
  "categories": [
    "test"
  ],
  "tags": [
    "test"
  ],
  "steps": [
    {
      "name": "feature",
      "disable": [
        "Smartent.Orchard.Extensions.Cms.ShapeTracing"
      ],
      "enable": [
        "Smartent.Orchard.Theme.Base.Samples"
      ]
    },
    {
      "name": "themes",
      "site": "Smartent.Orchard.Theme.Base.Samples"
    }
  ]
}
