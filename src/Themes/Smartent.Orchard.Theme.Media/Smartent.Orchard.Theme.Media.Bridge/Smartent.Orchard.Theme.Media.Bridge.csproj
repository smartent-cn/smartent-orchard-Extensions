<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Theme.Media.Bridge</RootNamespace>
    <AssemblyName>Smartent.Orchard.Theme.Media.Bridge</AssemblyName>
    <PackageId>Smartent.Orchard.Theme.Media.Bridge</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Media Theme Bridge for Orchard Core</Title>
    <CopyrightYear>2022</CopyrightYear>
    <DescriptionBody>Provides the processing logic for the Media Theme.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Media;Module</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' != 'true'">
    <ProjectReference Include="..\..\..\Modules\Smartent.Orchard.Extensions.Cms\Smartent.Orchard.Extensions.Cms\Smartent.Orchard.Extensions.Cms.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' == 'true'">
    <PackageReference Include="Smartent.Orchard.Extensions.Cms" Version="12.0.1-alpha.0.osoe-1317" />
  </ItemGroup>

  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" NoWarn="NU1510" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Module.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Module.Sdk" Version="2.1.1" />
</Project>
