<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Theme.Media</RootNamespace>
    <AssemblyName>Smartent.Orchard.Theme.Media</AssemblyName>
    <PackageId>Smartent.Orchard.Theme.Media</PackageId>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Media Theme for Orchard Core</Title>
    <CopyrightYear>2022</CopyrightYear>
    <DescriptionBody>With the help of this theme, you'll be able to host your theme templates and assets located in your Orchard Core Media Library.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Media;Theme</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smartent.Orchard.Theme.Media.Bridge\Smartent.Orchard.Theme.Media.Bridge.csproj" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.OrchardCore.Theme.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.OrchardCore.Theme.Sdk" Version="2.1.1" />
</Project>
