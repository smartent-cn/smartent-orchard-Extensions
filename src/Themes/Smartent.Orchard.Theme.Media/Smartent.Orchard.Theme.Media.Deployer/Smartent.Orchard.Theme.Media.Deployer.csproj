<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Smartent.Orchard.Theme.Media.Deployer</RootNamespace>
    <AssemblyName>Smartent.Orchard.Theme.Media.Deployer</AssemblyName>
    <PackageId>Smartent.Orchard.Theme.Media.Deployer</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>media-theme-deploy</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.Library.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Smartent.Build.Library.Sdk" Version="2.1.1" />

  <PropertyGroup>
    <Title>Smartent Orchard Hosting - Media Theme Deployer for Orchard Core</Title>
    <CopyrightYear>2022</CopyrightYear>
    <DescriptionBody>A tool to easily export Media Themes. See the project website for detailed documentation.</DescriptionBody>
    <PackageTags>OrchardCore;Smartent;AspNetCore;Media;Deployer</PackageTags>
    <RepositoryUrl>https://gitee.com/smartent/smartent-orchard-Extensions</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.github\actions\deploy-media-theme\action.yml" Link=".github\action.yml" />
    <None Include="..\.github\workflows\deploy-media-theme.yml" Link=".github\deploy-media-theme.yml" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Build/Smartent.Build.Library.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Smartent.Build.Library.Sdk" Version="2.1.1" />
</Project>
