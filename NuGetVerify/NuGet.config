<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ignore global configuration -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- <add key="OrchardCorePreview" value="https://nuget.cloudsmith.io/orchardcore/preview/v3/index.json" /> -->
    <!-- M7: Smartent 包验证用；发布前取消注释并填入实际 feed。 -->
    <!-- <add key="Smartent" value="https://gitee.com/api/v5/packages/smartent/nuget/index.json" /> -->
    <!-- 单体仓本地 feed（core pack / 独立 NuGetVerify Sdk 还原） -->
    <add key="SmartentLocal" value="../artifacts/smartent-nuget-local" />
  </packageSources>
  <!-- 本地 + 远程双源；精细 mapping 见 NuGet.config.local.example（独立检出时优先 local） -->
  <!-- M7 Gitee 远程源见 ../NuGet.config 与 projects/M7-Batch-15-GiteeNuGetConfig.md -->
  <auditSources>
    <!-- This is to prevent such errors during NuGet restore for Cloudsmith: "Error occurred while getting package
    vulnerability data: Unable to load the service index for source
    https://nuget.cloudsmith.io/orchardcore/preview/v3/index.json." -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
